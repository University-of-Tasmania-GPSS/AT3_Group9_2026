{"version":3,"kind":"Article","sha256":"29509a1aa88d9156fa954c6c7bdd84de2b3eb4a99c95abe8676a2af1bf55b1aa","slug":"discussion","location":"/discussion.md","dependencies":[],"frontmatter":{"title":"Discussion","content_includes_title":false,"numbering":{"title":{"offset":1}},"exports":[{"format":"md","filename":"discussion.md","url":"/discussion-4db8da95ca7079bfc4a645954ea5128d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Spatial Correlation","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jvuTwYJyy1"}],"identifier":"spatial-correlation","label":"Spatial Correlation","html_id":"spatial-correlation","implicit":true,"key":"Z3758vPRNZ"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Where are the police\nWhat crimes are being reported where\nPeople may not actually live in the places that they commit crimes\nSydney CBD is where there are a lot of bars, clubs and social events.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"uiojKwapkF"}],"key":"YuLjjkxUyw"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Socioeconomic Correlation","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"XXRCapcENI"}],"identifier":"socioeconomic-correlation","label":"Socioeconomic Correlation","html_id":"socioeconomic-correlation","implicit":true,"key":"QtCy3YoHk8"},{"type":"div","style":{"backgroundColor":"#e8f0ec","borderLeft":"5px solid #183D32","padding":"18px 22px","borderRadius":"8px","margin":"20px 0"},"children":[{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Important Note:","key":"h8weUZftNq"}],"key":"xEYJCe25PL"}],"key":"lbCBeI9V19"},{"type":"paragraph","children":[{"type":"text","value":"Correlation does not automatically imply causation. The results produced here cannot definatvely prove that these socioeconomic factors cause crime, only that there is a statistical relationship between the socioeconomic factors and the crime rates.","key":"XByC4Q4kOq"}],"key":"SUcWsUKQSQ"}],"key":"dJVLMzrHhR"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Time Correlation","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"fNnSXxE7UF"}],"identifier":"time-correlation","label":"Time Correlation","html_id":"time-correlation","implicit":true,"key":"xNkVmkE8ao"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Drug offences: usually not signifigant\nViolent Crime: On average a strong positive correlation, 26 out of 30 LGAs had statistically signifigant positive correlation over time which means it can be said that in those 26 LGAs violent crime has been increasing over time.\nProperty Offences: On average a strong negative correlation, 24 out of 30 LGAs had statistically signifigant negative correlation over time which means it can be said that in those 24 LGAs property offences have been decreasing over time.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"bqg3zQecNs"}],"key":"pkPCU3sHo4"},{"type":"comment","value":"Leave at the bottom","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"NGVzwXtStq"},{"type":"div","style":{"borderTop":"1px solid #cccccc","marginTop":"35px","paddingTop":"12px","fontSize":"0.9em","color":"#666"},"children":[{"type":"text","value":"GIS Project | Greater Sydney, New South Wales | 2015–2025","key":"beSPrLJDjE"}],"key":"UDfGTYdab9"}],"key":"fkHJ9f2nwJ"}],"key":"kJScvOPIBi"},"references":{"cite":{"order":[],"data":{}}}}